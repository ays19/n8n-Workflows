        "messages": {
          "values": [
            {
              "content": "Extract the data from this invoice image.\nReturn only valid JSON in exactly this structure. No explanation, no markdown.\nIf a value is missing, use an empty string \"\".\n\n{\n  \"receipt_id\": \"\",\n  \"date\": \"\",\n  \"customer\": { \"name\": \"\", \"email\": \"\", \"phone\": \"\" },\n  \"merchant\": { \"name\": \"\", \"address\": \"\", \"email\": \"\", \"phone\": \"\" },\n  \"line_items\": [\n    { \"title\": \"\", \"description\": \"\", \"price\": \"\", \"tax\": \"\" }\n  ],\n  \"subtotal\": \"\",\n  \"tax_total\": \"\",\n  \"total\": \"\",\n  \"currency\": \"\",\n  \"payment_method\": \"\",\n  \"status\": \"\"\n}",
              "role": "model"
            },
            {
              "content": "={{ $json.content.parts[0].text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        880,
        64
      ],
      "id": "074a9f66-3200-4036-974c-7a0d9c37393b",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "iZlTzt5gnss5w3vJ",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.content.parts[0].text;\nconst parsed = JSON.parse(raw.replace(/```json|```/g, \"\").trim());\n\nconst data = {\n  receipt_id: parsed.receipt_id ?? \"\",\n  date: parsed.date ?? \"\",\n  customer: {\n    name: parsed.customer?.name ?? \"\",\n    email: parsed.customer?.email ?? \"\",\n    phone: parsed.customer?.phone ?? \"\"\n  },\n  merchant: {\n    name: parsed.merchant?.name ?? \"\",\n    address: parsed.merchant?.address ?? \"\",\n    email: parsed.merchant?.email ?? \"\",\n    phone: parsed.merchant?.phone ?? \"\"\n  },\n  line_items: (parsed.line_items ?? []).map(i => ({\n    title: i.title ?? \"\",\n    description: i.description ?? \"\",\n    price: i.price ?? \"\",\n    tax: String(i.tax ?? \"\").replace(/\\+/g, \"\").trim()\n  })),\n  subtotal: parsed.subtotal ?? \"\",\n  tax_total: parsed.tax_total ?? \"\",\n  total: parsed.total ?? \"\",\n  currency: ({ \"$\": \"USD\", \"€\": \"EUR\", \"£\": \"GBP\", \"৳\": \"BDT\", \"₹\": \"INR\" })[parsed.currency] ?? parsed.currency ?? \"\",\n  payment_method: parsed.payment_method ?? \"\",\n  status: parsed.status ?? \"\"\n};\n\nreturn [{ json: data }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
