      "parameters": {
        "jsCode": "const raw = $input.first().json.content.parts[0].text;\nconst parsed = JSON.parse(raw.replace(/```json|```/g, \"\").trim());\n\nconst num = v => v === \"\" || v == null ? \"\" : parseFloat(String(v).replace(/[^0-9.\\-]/g, \"\"));\n\nconst data = {\n  receipt_id: parsed.receipt_id ?? \"\",\n  date: parsed.date ?? \"\",\n  customer: {\n    name: parsed.customer?.name ?? \"\",\n    email: parsed.customer?.email ?? \"\",\n    phone: parsed.customer?.phone ?? \"\"\n  },\n  merchant: {\n    name: parsed.merchant?.name ?? \"\",\n    address: parsed.merchant?.address ?? \"\",\n    email: parsed.merchant?.email ?? \"\",\n    phone: parsed.merchant?.phone ?? \"\"\n  },\n  line_items: (parsed.line_items ?? []).map(i => ({\n    title: i.title ?? \"\",\n    description: i.description ?? \"\",\n    price: num(i.price),\n    tax: String(i.tax ?? \"\").replace(/\\+/g, \"\").trim()\n  })),\n  subtotal: num(parsed.subtotal),\n  tax_total: num(parsed.tax_total),\n  total: num(parsed.total),\n  currency: ({ \"$\": \"USD\", \"€\": \"EUR\", \"£\": \"GBP\", \"৳\": \"BDT\", \"₹\": \"INR\" })[parsed.currency] ?? parsed.currency ?? \"\",\n  payment_method: parsed.payment_method ?? \"\",\n  status: parsed.status ?? \"\"\n};\n\nreturn [{ json: data }];"
      },
