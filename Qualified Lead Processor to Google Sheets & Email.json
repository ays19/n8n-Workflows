    {
      "parameters": {
        "jsCode": "// Get the first input item (the one containing the Leads array)\nconst input = $input.first().json;\n\n// Extract the Leads array\nconst leads = input.Leads || [];\n\n// Sort the leads from highest to lowest Budget\nconst sortedLeads = leads.sort((a, b) => Number(b.Budget) - Number(a.Budget));\n\n// Return the data in the same structure\nreturn [\n  {\n    json: {\n      Leads: sortedLeads\n    }\n  }\n];"
      },
