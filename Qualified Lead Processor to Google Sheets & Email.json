      "parameters": {
        "jsCode": "// Get the first input item\nconst input = $input.first().json;\n\n// Extract the Leads array\nconst leads = input.Leads || [];\n\n// Build a plain text summary dynamically\nconst text = leads.map(lead => {\n  return `Full Name: ${lead[\"Full Name\"]}\nEmail: ${lead.Email}\nService: ${lead.Service}\nBudget: ${lead.Budget}\n----------------------------`;\n}).join('\\n');\n\n// Return as a single text field\nreturn [\n  {\n    json: {\n      text: text\n    }\n  }\n];"
      },
